{
	"schemaVersion": 1,
	"id": "windsmoke",
	"version": "${version}",
	"name": "Must've Been the Wind",
	"description": "A living wind system: weather-driven gusts, wind-blown campfire smoke, slanting rain, and drifting clouds.",
	"authors": [
		"AkSinghSidhu"
	],
	"contact": {
		"homepage": "https://github.com/AkSinghSidhu/mustve-been-the-wind",
		"sources": "https://github.com/AkSinghSidhu/mustve-been-the-wind",
		"issues": "https://github.com/AkSinghSidhu/mustve-been-the-wind/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/windsmoke/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.windsmoke.WindSmoke"
		],
		"client": [
			"com.windsmoke.client.WindSmokeClient"
		]
	},
	"mixins": [
		{
			"config": "windsmoke.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
